{
  "name": "log-looker",
  "private": true,
  "version": "1.1.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build:major": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 -Bump major",
    "build:minor": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 -Bump minor",
    "build:patch": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 -Bump patch",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run test:run && npm run test:rust",
    "test:run": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "pinia": "^3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
